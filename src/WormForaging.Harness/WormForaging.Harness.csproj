<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Generic Host stack: the single composition root (Microsoft DI), YAML configuration, and
       Microsoft.Extensions.Logging fronting Serilog. Deliberately the same shape (and versions) as
       the Avalonia app's shell, so the harness reads the same appsettings.yaml and logs the same
       way. There is no shared hosting assembly on purpose: Core stays a pure simulation with no
       Hosting/Serilog dependency, so each executable owns its own thin host builder. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Command-line parsing for the experiment knobs (seeds, steps, output directory, ...). -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WormForaging.Core\WormForaging.Core.csproj" />
  </ItemGroup>

</Project>
