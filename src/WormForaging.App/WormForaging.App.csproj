<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets live at the repository root (../../assets) but keep their logical avares path
         "/Assets/..." via Link, so XAML references such as Icon="/Assets/avalonia-logo.ico" are
         unaffected by the move. Mirrors how HyperSpace links its root Resources/ folder. -->
    <AvaloniaResource Include="..\..\assets\**">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

  <!-- Avalonia UI stack. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- MVVM primitives only (BindableBase / DelegateCommand). Prism.Core carries no container, so it
       coexists with the Microsoft DI container below without conflict. Version matches HyperSpace. -->
  <ItemGroup>
    <PackageReference Include="Prism.Core" Version="7.2.0.1422" />
  </ItemGroup>

  <!-- Generic Host stack: the single composition root (Microsoft DI), YAML configuration, and
       Microsoft.Extensions.Logging fronting Serilog. Same shape as the HyperSpace shell. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Command-line parsing for the seed, config path, and log-level options. Parse-only: it feeds
       startup options into the host; Avalonia drives the UI loop. -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WormForaging.Core\WormForaging.Core.csproj" />
  </ItemGroup>
</Project>
