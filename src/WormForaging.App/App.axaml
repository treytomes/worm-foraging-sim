<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WormForaging.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the system theme variant; "Dark"/"Light" force one. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
