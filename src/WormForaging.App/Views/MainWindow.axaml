<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WormForaging.App.ViewModels"
        xmlns:controls="using:WormForaging.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="860"
        x:Class="WormForaging.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Two needs, no backprop"
        Width="780"
        Height="860"
        Background="{DynamicResource ControlBrush}">

    <DockPanel>
        <!-- The toolbar: a bordered strip docked below the title bar. It carries the theme switch
             (right-aligned) and leaves the left side free for controls migrated out of the grid. -->
        <Border DockPanel.Dock="Top"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource ComponentGrayBrush}"
                Background="{DynamicResource ComponentLightGrayBrush}">
            <!-- LastChildFill="False": otherwise the DockPanel stretches its last child and undocks
                 the switch from the right edge. -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                    <Button Content="{Binding RunButtonText}" Command="{Binding ToggleRunCommand}" Theme="{StaticResource ButtonDefault}" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Theme="{StaticResource ButtonDefault}" />
                    <Button Content="Swap senses" Command="{Binding SwapSensesCommand}" Theme="{StaticResource ButtonDefault}" />

                    <ComboBox SelectedIndex="{Binding ModeIndex}" Width="140" Margin="6,4,0,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="Three-factor" />
                        <ComboBoxItem Content="Plain Hebbian" />
                        <ComboBoxItem Content="Frozen" />
                    </ComboBox>

                    <CheckBox Content="homeostasis" IsChecked="{Binding HomeostasisEnabled}" VerticalAlignment="Center" Margin="6,0,0,0" />

                    <TextBlock Text="explore" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource ComponentText}" />
                    <Slider Minimum="0.3" Maximum="3" Value="{Binding ExploreTemperature}" Width="90" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExploreTemperature, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" Foreground="{DynamicResource ComponentText}" />

                    <TextBlock Text="speed" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource ComponentText}" />
                    <Slider Minimum="1" Maximum="60" Value="{Binding Speed}" Width="90" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Speed}" VerticalAlignment="Center" Foreground="{DynamicResource ComponentText}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton GroupName="ThemeVariant"
                                 Content="Light"
                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                 ToolTip.Tip="Light theme"
                                 Theme="{StaticResource RadioButtonLeftDefault}" />
                    <RadioButton GroupName="ThemeVariant"
                                 Content="Dark"
                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                 ToolTip.Tip="Dark theme"
                                 Theme="{StaticResource RadioButtonCenterDefault}" />
                    <RadioButton GroupName="ThemeVariant"
                                 Content="System"
                                 IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                 ToolTip.Tip="Follow the system theme"
                                 Theme="{StaticResource RadioButtonRightDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The status bar: a flat strip along the bottom, separated from the content by a hairline. -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,3"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ComponentGrayBrush}"
                Background="{DynamicResource ControlBrush}">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ComponentText}" />
            </DockPanel>
        </Border>

        <!-- 2x2 layout: (0,0) arena, (0,1) control panel, (1,0) plots, (1,1) reserved. -->
        <Grid Margin="12"
              RowDefinitions="*,*"
              ColumnDefinitions="*,*"
              RowSpacing="8"
              ColumnSpacing="8">

            <controls:ArenaControl Grid.Row="0"
                                   Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   SimulationSnapshot="{Binding CurrentSnapshot}"
                                   Trail="{Binding Trail}"
                                   ArenaSize="{Binding ArenaSize}"
                                   ComfortTemperature="{Binding ComfortTemperature}"
                                   BackgroundBrush="{DynamicResource ArenaBackgroundBrush}"
                                   FieldBrush="{DynamicResource ChartBackgroundBrush}"
                                   WormBrush="{DynamicResource WormBrush}"
                                   TrailBrush="{DynamicResource TrailBrush}"
                                   LampBrush="{DynamicResource LampBrush}"
                                   FoodBrush="{DynamicResource FoodBrush}"
                                   HotRingBrush="{DynamicResource NegativeBrush}"
                                   ColdRingBrush="{DynamicResource ColdBrush}"
                                   LampGlowColor="{DynamicResource LampGlowColor}"
                                   FoodGlowColor="{DynamicResource FoodGlowColor}" />

            <Grid Grid.Row="1" Grid.Column="0"
                  RowDefinitions="*,*,*"
                  RowSpacing="8">
                <controls:HistoryPlotControl Grid.Row="0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             History="{Binding History}"
                                             ComfortTemperature="{Binding ComfortTemperature}"
                                             BackgroundBrush="{DynamicResource ChartBackgroundBrush}"
                                             TextBrush="{DynamicResource ChartTextBrush}"
                                             EnergyBrush="{DynamicResource PositiveBrush}"
                                             BodyTempBrush="{DynamicResource NegativeBrush}"
                                             ComfortBandBrush="{DynamicResource ComfortBandBrush}" />

                <controls:NetworkPlotControl Grid.Row="1"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             Activations="{Binding CurrentSnapshot.Activations}"
                                             ReadoutWeights="{Binding CurrentSnapshot.ReadoutWeights}"
                                             BackgroundBrush="{DynamicResource ChartBackgroundBrush}"
                                             TextBrush="{DynamicResource ChartTextBrush}"
                                             PositiveBrush="{DynamicResource PositiveBrush}"
                                             NegativeBrush="{DynamicResource NegativeBrush}"
                                             AxisBrush="{DynamicResource ChartTextBrush}" />

                <controls:MealPlotControl Grid.Row="2"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          MealIntervals="{Binding CurrentSnapshot.MealIntervals}"
                                          BackgroundBrush="{DynamicResource ChartBackgroundBrush}"
                                          TextBrush="{DynamicResource ChartTextBrush}"
                                          LineBrush="{DynamicResource PositiveBrush}" />
            </Grid>

            <controls:WiringDiagramControl Grid.Row="1" Grid.Column="1"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Topology="{Binding Topology}"
                                           Activations="{Binding CurrentSnapshot.Activations}"
                                           ReadoutWeights="{Binding CurrentSnapshot.ReadoutWeights}"
                                           Modulator="{Binding CurrentSnapshot.Modulator}"
                                           FoodDrive="{Binding CurrentSnapshot.FoodDrive}"
                                           ThermalDrive="{Binding CurrentSnapshot.ThermalDrive}"
                                           BackgroundBrush="{DynamicResource ChartBackgroundBrush}"
                                           TextBrush="{DynamicResource ChartTextBrush}"
                                           PositiveBrush="{DynamicResource PositiveBrush}"
                                           NegativeBrush="{DynamicResource NegativeBrush}" />
        </Grid>
    </DockPanel>
</Window>
